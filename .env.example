# Llaves de Wompi (Bancolombia). Copia este archivo como .env y completa los valores.
# Obtén tus llaves en https://comercios.wompi.co

# Llave pública: pub_test_... (sandbox) o pub_prod_... (producción)
VITE_WOMPI_PUBLIC_KEY=

# Secreto de integridad (para firmar la transacción)
VITE_WOMPI_INTEGRITY=

# Entorno: 'test' (sandbox) o 'prod' (producción)
VITE_WOMPI_ENV=test

# URL del backend (recomendado). Si se define, la firma se genera en el servidor
# y NO necesitas exponer VITE_WOMPI_INTEGRITY en el navegador.
VITE_API_BASE=http://localhost:3001

# Correo de destino del formulario de contacto (FormSubmit)
VITE_CONTACT_EMAIL=

# WhatsApp con código de país, solo dígitos (57 + número)
VITE_WHATSAPP_NUMBER=573007448983
